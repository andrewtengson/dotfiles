#!/bin/bash

alias \
  vi='nvim' \
  vim='nvim' \
  cp='cp -iv' \
  mv='mv -iv' \
  rm='rm -iv' \
  k9s='TERM=xterm-256color k9s'

case "$(uname -s)" in
  "Linux") alias \
    pbcopy='xsel --clipboard --input' \
    pbpaste='xsel --clipboard --output' \
    ls='ls --color=auto' \
    open='xdg-open'
  ;;
  "Darwin") alias \
    ls='ls -G'
  ;;
esac

if [[ -f "$HOME/.claude/local/claude" ]]; then
  alias claude="~/.claude/local/claude"
fi

cursor_sync_shim="$HOME/.config/cursor-agent/sync-output.cjs"
if [[ -f "$cursor_sync_shim" ]]; then
  alias \
    cursor-agent="NODE_OPTIONS=\"\${NODE_OPTIONS:+\$NODE_OPTIONS }--require $cursor_sync_shim\" cursor-agent" \
    agent="NODE_OPTIONS=\"\${NODE_OPTIONS:+\$NODE_OPTIONS }--require $cursor_sync_shim\" agent"
fi
unset cursor_sync_shim
